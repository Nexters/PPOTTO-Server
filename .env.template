# ppotto 서버 환경변수 템플릿
# 복사해서 사용: 로컬 = 레포 루트 .env / 서버 = ~/secrets/.env.dev 또는 ~/secrets/.env.production
# APP_IMAGE는 CD 워크플로우가 compose 실행 시 주입하므로 이 파일에 넣지 않는다

# ── 서버 / 도메인 ──────────────────────────────────────────────
# DEPLOY_ENV=dev 일 때만 BearerTokenAuthenticationFilter가 인증 실패 상세 로그를 남긴다
APP_DOMAIN=dev-api.example.com
SERVER_PORT=8080
DEPLOY_ENV=local
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=54782
POSTGRES_DB=ppotto
POSTGRES_USER=ppotto
POSTGRES_PASSWORD=ppotto

# ── Valkey (Redis) ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT_MILLIS=2000
REDIS_TIMEOUT_MILLIS=2000

# ── GCS (사진 스토리지) ────────────────────────────────────────
GCS_BUCKET=
GCS_CREDENTIALS_PATH=./secrets/gcs-service-account.json
GCS_UPLOAD_SIGNED_URL_EXPIRATION_MINUTES=15
GCS_READ_SIGNED_URL_EXPIRATION_MINUTES=60
GCS_TIMEOUT_MILLIS=5000

# ── OAuth 공통 ────────────────────────────────────────────────
OAUTH_CONNECT_TIMEOUT_MILLIS=3000
OAUTH_READ_TIMEOUT_MILLIS=5000

# ── Kakao 로그인 ──────────────────────────────────────────────
KAKAO_APP_ID=
KAKAO_ACCESS_TOKEN_INFO_URI=https://kapi.kakao.com/v1/user/access_token_info
KAKAO_USER_INFO_URI=https://kapi.kakao.com/v2/user/me

# ── Apple 로그인 ──────────────────────────────────────────────
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=./secrets/AuthKey.p8
APPLE_ISSUER=https://appleid.apple.com
APPLE_JWKS_URI=https://appleid.apple.com/auth/keys
APPLE_TOKEN_URI=https://appleid.apple.com/auth/token
APPLE_REVOKE_URI=https://appleid.apple.com/auth/revoke
APPLE_CLIENT_SECRET_EXPIRATION_DAYS=180
APPLE_JWKS_CACHE_SECONDS=3600

# ── JWT / 토큰 암호화 ─────────────────────────────────────────
JWT_ISSUER=ppotto
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=3600
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=30
USER_PROVIDER_REFRESH_TOKEN_ENCRYPTION_KEY_BASE64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# ── 탈퇴 유저 정리 배치 ────────────────────────────────────────
USER_WITHDRAWN_CLEANUP_ENABLED=false
USER_WITHDRAWN_CLEANUP_RETENTION_DAYS=30
USER_WITHDRAWN_CLEANUP_BATCH_SIZE=100
USER_WITHDRAWN_CLEANUP_CRON="0 0 4 * * *"

# ── Swagger ───────────────────────────────────────────────────
SWAGGER_USER=ppotto
SWAGGER_PASSWORD=ppotto

# ── Vertex AI (Gemini) ────────────────────────────────────────
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=
VERTEX_AI_CLASSIFY_TIMEOUT_MS=180000
VERTEX_AI_VERIFY_TIMEOUT_MS=30000

# ── Pixian (스티커 배경 제거) ──────────────────────────────────
PIXIAN_API_ID=
PIXIAN_API_SECRET=
PIXIAN_TEST_MODE=true
PIXIAN_REMOVE_BACKGROUND_URI=https://api.pixian.ai/api/v2/remove-background
PIXIAN_CONNECT_TIMEOUT_MILLIS=5000
PIXIAN_READ_TIMEOUT_MILLIS=180000

# ── Sentry (에러 추적 / 트레이싱) ───────────────────────────────
# SENTRY_DSN을 비우면 SDK가 비활성 상태로 뜬다. 로컬은 비워 두는 것이 기본
# SENTRY_ENVIRONMENT / SENTRY_TRACES_SAMPLE_RATE는 배포 환경에서 compose 오버라이드가 주입한다
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=1.0

